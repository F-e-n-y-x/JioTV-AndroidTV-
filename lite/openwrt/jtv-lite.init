#!/bin/sh /etc/rc.common
# /etc/init.d/jtv-lite — procd service. Enable: /etc/init.d/jtv-lite enable && /etc/init.d/jtv-lite start
START=99
USE_PROCD=1

start_service() {
	mkdir -p /etc/jtv-lite
	procd_open_instance
	procd_set_param command /usr/bin/jtv-lite -data /etc/jtv-lite/jtv-lite.json
	procd_set_param env GOGC=50
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
