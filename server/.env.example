# The server works with NO .env at all — on first run, open the web UI and create an admin password;
# the TV access token is generated for you and shown in the dashboard. Everything is saved to
# <DATA_DIR>/config.json (and credentials to the SQLite DB). Copy this to .env only if you want to
# override the defaults below (e.g. headless/automated deploys).

# HTTP port the server listens on.
PORT=8080

# Where SQLite + config.json are stored (mounted as a Docker volume in compose).
DATA_DIR=./data

# ── Optional overrides (skip these and use the browser setup instead) ──
# If set, these take precedence over the browser-configured values in config.json:
# ADMIN_PASSWORD=
# JTV_SERVER_TOKEN=

# Master key to lock the settings/admin dashboard. When set, the dashboard is ALWAYS gated (even if you
# chose "no password" during setup) and this key unlocks it — so not just anyone on the LAN can open
# settings. Enter it on the dashboard's login screen.
# MASTER_KEY=291100

# Trust X-Forwarded-Proto/Host/For from a reverse proxy (Cloudflare, Caddy). Default: true.
# true | false | a hop count (e.g. 1) | comma-separated proxy IPs/CIDRs. Use false when the port is
# reachable directly from the internet with no proxy in front (forwarded headers would be spoofable).
# TRUST_PROXY=true
